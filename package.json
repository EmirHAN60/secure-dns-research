{
  "name": "secure-dns-research",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reproducible UDP DNS and HTTP2 DoH measurements with a controlled browser fixture",
  "dependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/test_dns.mjs",
    "test:dns": "node tests/test_dns.mjs",
    "test:live": "node tests/test_live.mjs",
    "test:analysis": "python -m unittest discover -s tests -p test_*.py -v",
    "analyze": "python scripts/analyze.py --strict",
    "reproduce": "python scripts/reproduce.py"
  }
}
